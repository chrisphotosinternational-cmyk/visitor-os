{
  "name": "live-split-studio",
  "version": "0.2.1",
  "private": true,
  "description": "Autonomous code editor with split live preview, save and safe minification.",
  "main": "electron.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "build:renderer": "vite build",
    "dist:mac": "npm run build:renderer && electron-builder --mac dmg zip --publish never",
    "dist": "npm run build:renderer && electron-builder --publish never"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "html-minifier-terser": "^7.2.0",
    "clean-css": "^5.3.3",
    "terser": "^5.43.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^7.0.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.6",
    "vite": "^8.0.0",
    "wait-on": "^8.0.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.chrisphotos.livesplitstudio",
    "productName": "Live Split Studio",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron.cjs",
      "preload.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ]
    },
    "dmg": {
      "title": "Live Split Studio ${version}"
    },
    "artifactName": "Live-Split-Studio-${version}-${arch}.${ext}"
  }
}