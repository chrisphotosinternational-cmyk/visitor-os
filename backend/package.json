{
  "name": "@visitor-os/backend",
  "version": "1.0.0-RC1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "description": "VISITOR-OS backend foundation",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm build && node --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "smoke:chatbot-seed": "node scripts/seed-chatbot-smoke-staging.mjs",
    "smoke:chatbot-cleanup": "node scripts/cleanup-chatbot-smoke-staging.mjs",
    "smoke:chatbot-public": "node scripts/chatbot-public-runtime-smoke.mjs",
    "benchmark:chatbot-conversations": "tsc -p tsconfig.test.json && node --test dist-test/tests/chatbot-conversation-benchmark.test.js",
    "benchmark:chatbot-runtime": "tsc -p tsconfig.test.json && node --test dist-test/tests/chatbot-runtime-conversation-benchmark.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/tests/**/*.test.js\" scripts/chatbot-smoke-staging-fixtures.test.mjs",
    "test:coverage": "tsc -p tsconfig.test.json && node --experimental-test-coverage --test \"dist-test/tests/**/*.test.js\"",
    "lint": "eslint . --ignore-pattern 'scripts/**/*.mjs'",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "vue": "3.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
